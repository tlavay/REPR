<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<PropertyGroup>
		  <PackageId>REPR</PackageId>
		  <Version>10.0.0</Version>
			<Company>LaVayApplications</Company>
		  <Authors>Tyler La Vay</Authors>
		  <Description>
			  Rest EndPoint Response REPR is a lightweight library that implements the Mediator design pattern in .NET.
			  It helps decouple the sender of a request from its handler, promoting cleaner architecture and separation of concerns.
			  Instead of calling services or logic directly, you send a request (like a command or query),
			  and REPR routes it to the appropriate handler.
			  GIT: https://github.com/tlavay/REPR
		  </Description>
		  <PackageTags>REPR;MediatorPattern;</PackageTags>
	</PropertyGroup>
	<PropertyGroup>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
	<ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.2" />
  </ItemGroup>
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<!-- Include the source generator in the package as an analyzer -->
	<ItemGroup>
		<ProjectReference Include="..\REPR.SourceGeneration\REPR.SourceGeneration.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
	</ItemGroup>
	
	<!-- Pack the source generator DLL into the analyzers folder -->
	<ItemGroup>
		<None Include="..\REPR.SourceGeneration\bin\$(Configuration)\netstandard2.0\REPR.G.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>

	<ItemGroup>
    <InternalsVisibleTo Include="REPR.UnitTests" />
  </ItemGroup>

</Project>
